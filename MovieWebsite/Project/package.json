{
  "name": "movie-app",
  "version": "1.0.0",
  "private": true,
  "description": "CineStream - Movie Streaming Website",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "eslint --ext .ts,.tsx frontend/src backend/src",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\"",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx}\" \"backend/src/**/*.ts\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
