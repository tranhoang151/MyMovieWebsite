'use client';

import { useMovie } from '@/hooks/useMovies';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';
import VideoPlayer from '@/components/player/VideoPlayer';
import EpisodeNav from '@/components/player/EpisodeNav';
import { ArrowLeft } from 'lucide-react';
import { useEffect, useState } from 'react';
import { useAuthStore } from '@/store/authStore';
import api from '@/lib/axios';

export default function WatchPage() {
  const params = useParams();
  const slug = params.slug as string;
  const ep = params.ep as string;
  const { data: movie, isLoading } = useMovie(slug);
  const { isAuthenticated } = useAuthStore();
  const [currentServer, setCurrentServer] = useState('');
  const [episodes, setEpisodes] = useState<{ name: string; slug: string }[]>([]);

  useEffect(() => {
    if (movie?.episodes) {
      const grouped: { [k: string]: { name: string; slug: string }[] } = {};
      movie.episodes.forEach((e: any) => {
        if (!grouped[e.serverName]) grouped[e.serverName] = [];
        grouped[e.serverName].push({ name: e.name, slug: e.slug });
      });
      const servers = Object.keys(grouped);
      if (servers.length > 0) {
        if (!currentServer || !grouped[currentServer]) setCurrentServer(servers[0]);
        setEpisodes(grouped[currentServer] || grouped[servers[0]]);
      }
    }
  }, [movie, currentServer]);

  // Auto-save watch progress
  const handleTimeUpdate = (time: number) => {
    if (!isAuthenticated || !movie) return;
    api.post('/history', {
      movieId: movie.id,
      episodeSlug: ep,
      serverName: currentServer,
      progressSec: Math.floor(time),
    }).catch(() => {});
  };

  const currentEpData = movie?.episodes?.find((e: any) => e.slug === ep && e.serverName === currentServer);

  if (isLoading) {
    return (
      <div className="min-h-screen bg-netflix-dark flex items-center justify-center">
        <div className="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-netflix-red" />
      </div>
    );
  }

  if (!movie || !currentEpData) {
    return (
      <div className="min-h-screen bg-netflix-dark flex flex-col items-center justify-center text-white gap-4">
        <p>Không tìm thấy tập phim.</p>
        <Link href={`/movies/${slug}`} className="text-netflix-red hover:underline">Quay lại trang phim</Link>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-netflix-dark text-white">
      {/* Back button */}
      <div className="p-4">
        <Link href={`/movies/${slug}`} className="inline-flex items-center text-netflix-text-secondary hover:text-white transition-colors">
          <ArrowLeft size={20} className="mr-2" /> Quay lại
        </Link>
      </div>

      {/* Video Player */}
      <div className="max-w-7xl mx-auto px-4">
        <VideoPlayer
          m3u8Url={currentEpData.m3u8Url}
          embedUrl={currentEpData.embedUrl}
          onTimeUpdate={handleTimeUpdate}
        />

        <div className="mt-4">
          <h1 className="text-xl font-bold">{movie.name}</h1>
          <p className="text-netflix-text-secondary text-sm mt-1">
            {currentEpData.name} — {currentServer}
          </p>
        </div>

        <EpisodeNav slug={slug} currentEp={ep} episodes={episodes} />

        {/* Server Selector */}
        {movie.episodes && [...new Set(movie.episodes.map((e: any) => e.serverName))].length > 1 && (
          <div className="flex gap-2 mt-4 flex-wrap">
            {[...new Set(movie.episodes.map((e: any) => e.serverName))].map((serverName) => (
              <button
                key={serverName}
                onClick={() => setCurrentServer(serverName as string)}
                className={`px-3 py-1 rounded text-sm ${currentServer === serverName ? 'bg-netflix-red text-white' : 'bg-netflix-card text-netflix-text-secondary hover:bg-netflix-hover'}`}
              >
                {serverName as string}
              </button>
            ))}
          </div>
        )}

        {/* Episode grid */}
        <div className="mt-8 pb-12">
          <h2 className="text-lg font-bold mb-4">Danh sách tập</h2>
          <div className="grid grid-cols-6 md:grid-cols-10 lg:grid-cols-14 gap-2">
            {episodes.map(e => (
              <Link
                key={e.slug}
                href={`/watch/${slug}/${e.slug}`}
                className={`text-center py-2 rounded text-sm transition-colors ${e.slug === ep ? 'bg-netflix-red text-white' : 'bg-netflix-card text-netflix-text-secondary hover:bg-netflix-hover hover:text-white'}`}
              >
                {e.name}
              </Link>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}